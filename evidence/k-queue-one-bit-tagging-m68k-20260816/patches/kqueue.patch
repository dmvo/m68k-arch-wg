+static inline void z_queue_node_init(sys_queue_node_t *node, uintptr_t flags)
+{
+	__ASSERT((flags & ~(uintptr_t)Z_QUEUE_NODE_FLAG_ALLOCATED) == 0U,
+		 "invalid k_queue node flags");
+	node->next_and_flags = flags;
+}
